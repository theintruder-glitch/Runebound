extends SceneTree
const Data=preload("res://scripts/data.gd")
var checks=0
func _initialize(): call_deferred("run")
func check(ok:bool,message:String):
 if not ok:
  push_error("FAIL: "+message); quit(1); assert(ok,message)
 checks+=1; print("PASS: "+message)
func run():
 root.content_scale_mode=Window.CONTENT_SCALE_MODE_DISABLED
 root.size=Vector2i(480,900)
 var game=load("res://scenes/main.tscn").instantiate()
 root.add_child(game)
 await process_frame
 game.start_character(Data.fresh("Warrior"))
 game.set_physics_process(false)
 game.hero.auto=false; game.enemies.clear()
 var camp=game.survival
 check(game.forest.step()==0,"Opening gives a gathering objective")
 for key in camp.MATERIALS: camp.add(key,100)
 check(game.forest.step()==1,"Materials advance opening to campfire")
 game.facing=Vector2.DOWN
 check(camp.craft("Campfire"),"Opening campfire can be built")
 check(game.forest.step()==2,"Opening asks player to cook")
 check(camp.craft("Roasted berries"),"Cooking is recorded for the journey")
 check(game.forest.step()==3,"Cooking advances to shelter objective")
 game.set_player_position(Vector2(200,0))
 check(camp.craft("Shelter"),"Opening shelter can be built")
 check(game.forest.step()==4,"Shelter reveals the first dungeon objective and bearing")
 game.set_player_position(Vector2(-400,0))
 var before=camp.count("Plank")
 game.begin_build("Wall")
 check(camp.count("Plank")==before,"Starting preview spends no materials")
 game.cancel_build()
 check(camp.count("Plank")==before and game.build_recipe.is_empty(),"Cancelling preview spends no materials")
 game.begin_build("Wall"); game.build_rotation=1
 var spot=camp.place_position()
 game.interact()
 var wall=game.hero.survival.structures[-1]
 check(wall.kind=="Wall" and wall.rotation==1 and game.build_recipe.is_empty(),"Confirming placement commits rotation and exits preview")
 check(not game.walkable(spot,5),"Walls block character movement")
 check(not game.line_clear(spot+Vector2(-50,0),spot+Vector2(50,0)),"Walls block projectiles and attack sight lines")
 var planks=camp.count("Plank")
 game.set_player_position(Vector2(-600,0))
 game.begin_build("Wall",wall)
 game.interact()
 check(camp.count("Plank")==planks and camp.at(wall)!=spot,"Moving an existing structure spends no materials")
 game.begin_build("Roof",wall)
 game.begin_build("Bed")
 check(camp.moving.is_empty(),"Choosing a new recipe clears move mode")
 game.cancel_build()
 game.set_player_position(Vector2(-800,0))
 check(camp.craft("Door"),"Doors can be built")
 var door=game.hero.survival.structures[-1]
 check(not game.walkable(camp.at(door),5),"Closed door blocks passage")
 check(camp.toggle_door(door) and game.walkable(camp.at(door),5),"Opening a door allows passage")
 game.set_player_position(camp.at(door))
 check(not camp.toggle_door(door),"A door cannot close through the character")
 game.set_player_position(Vector2(-1000,0))
 check(camp.craft("Bed"),"Beds can be built")
 var bed=game.hero.survival.structures[-1]
 game.hero.hp=10
 check(camp.rest(bed) and game.hero.hp==Data.max_hp(game.hero),"Rest restores health and sets a bed return point")
 var home=Vector2(game.hero.respawn.x,game.hero.respawn.y)
 game.defeated()
 check(game.player_position()==home,"Defeat returns the player beside the chosen bed")
 game.playing=true; game.enemies.clear()
 game.set_player_position(Vector2(-1200,0))
 check(camp.craft("Storage"),"Storage chests can be built")
 var chest=game.hero.survival.structures[-1]
 var wood=camp.count("Wood")
 check(camp.transfer(chest,true) and camp.count("Wood")==0 and chest.stash.Wood==wood,"Storage deposits materials without loss")
 check(not camp.dismantle(chest),"Filled storage cannot be dismantled")
 check(camp.transfer(chest,false) and camp.count("Wood")==wood and chest.stash.is_empty(),"Storage withdraws materials without loss")
 var plank_before=camp.count("Plank")
 check(camp.dismantle(chest) and camp.count("Plank")==plank_before+2,"Dismantling returns half the recipe cost")
 game.set_player_position(Vector2(0,-300))
 var enemy=game.create_enemy(game.player_position()+Vector2(20,0),1,"goblin",false)
 game.hero.hp=100
 game.update_enemy_attack(enemy,.1)
 check(enemy.windup>0 and game.hero.hp==100,"Enemy attack starts with a warning and no instant damage")
 game.set_player_position(game.player_position()+Vector2(100,0))
 game.update_enemy_attack(enemy,1)
 check(game.hero.hp==100,"Leaving the warning circle avoids damage")
 enemy.cooldown=0; enemy.pos=game.player_position()+Vector2(20,0)
 game.update_enemy_attack(enemy,.1); game.update_enemy_attack(enemy,1)
 check(game.hero.hp<100,"Staying in the warning circle takes damage")
 enemy.cooldown=0; game.hero.hp=100
 game.update_enemy_attack(enemy,.1); game.dash_time=.5; game.update_enemy_attack(enemy,1)
 check(game.hero.hp==100,"Dashing through impact avoids damage")
 game.dash_time=0
 game.set_player_position(game.forest.SHRINE)
 check(not camp.reason("Wall").is_empty(),"Construction cannot obstruct the boss shrine")
 game.forest.interact()
 check(game.forest.active() and game.forest.boss.named=="The Root Warden","Shrine starts a named boss encounter")
 var boss=game.forest.boss
 game.hero.hp=Data.max_hp(game.hero)
 game.update_enemy_attack(boss,.1)
 check(boss.windup>=1 and boss.strike_radius==72,"Boss uses a readable longer warning")
 boss.windup=0; boss.cooldown=0; boss.hp=boss.max_hp*.4
 game.update_enemy_attack(boss,.1)
 check(boss.strike_radius==95,"Warden's second phase changes its attack area")
 game.kill_enemy(boss,"melee")
 check(game.hero.journey.warden and "Arcane Archer" in game.hero.unlocked,"Boss victory unlocks the adventure class path")
 var items=game.hero.inventory.duplicate(true)
 while game.hero.inventory.size()<40: game.hero.inventory.append(Data.roll_loot(1))
 check(not game.forest.claim_reward() and not game.hero.journey.reward,"Full inventory does not consume the unique reward")
 game.hero.inventory=items
 var size=items.size()
 check(game.forest.claim_reward() and game.hero.inventory.size()==size+1,"Shrine grants the unique enchanted weapon")
 check(not game.forest.claim_reward() and game.hero.inventory.size()==size+1,"Unique reward cannot be claimed twice")
 game.save_game()
 var saved=Data.read_save()
 check(saved.journey.warden and saved.journey.reward and saved.respawn.x==home.x,"Journey and bed return point survive save/reload")
 check(saved.survival.structures[2].rotation==1,"Structure rotation survives save/reload")
 game.set_player_position(Vector2(-1400,0))
 check(camp.craft("Storage"),"A fresh chest can be placed after the encounter")
 var saved_chest=game.hero.survival.structures[-1]
 check(camp.transfer(saved_chest,true),"Materials can be stored for a later session")
 game.save_game(); saved=Data.read_save()
 check(saved.survival.structures[-1].stash==saved_chest.stash and not saved_chest.stash.is_empty(),"Filled chest contents survive save/reload")
 camp.transfer(saved_chest,false)
 game.set_player_position(camp.at(bed)-Vector2(0,96))
 check(camp.craft("Roof"),"A canopy can cover a bed without blocking it")
 var legacy=Data.fresh("Mage"); legacy.erase("journey"); legacy.erase("respawn")
 check(not Data.migrate(legacy).is_empty() and legacy.journey.warden==false,"Older characters gain journey and return-point defaults")
 game.hud.show_character("camp")
 await process_frame
 check(game.hud.overlay.visible,"Expanded camp menu opens successfully")
 check(game.audio.CUES.size()>=7,"Original action sound assets are available")
 print(str(checks)+" FOREST MILESTONE CHECKS PASSED")
 quit()
