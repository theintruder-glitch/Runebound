extends SceneTree
const Data=preload("res://scripts/data.gd")
var checks=0
var game
func _initialize(): call_deferred("run")
func check(ok:bool,message:String):
	if not ok: push_error("FAIL: "+message);quit(1);assert(ok,message)
	checks+=1;print("PASS: "+message)
func settle(): await process_frame;await process_frame
func touch(at:Vector2,index:int,down:bool=true,canceled:bool=false):
	var event=InputEventScreenTouch.new();event.position=at;event.index=index;event.pressed=down;event.canceled=canceled;root.push_input(event,true)
func drag(at:Vector2,index:int):
	var event=InputEventScreenDrag.new();event.position=at;event.index=index;root.push_input(event,true)
func key(code:int,pressed:bool=true):
	var event=InputEventKey.new();event.keycode=code;event.physical_keycode=code;event.pressed=pressed;Input.parse_input_event(event)
func fresh():
	game.hud.resume();game.set_physics_process(false);game.hero.auto=false;game.enemies.clear();game.spawn_timer=99999
	game.hero.mp=Data.max_mp(game.hero);game.spellbook.reset();game.spell_cooldowns={};game.attack_cooldown=0;game.dash_time=0;game.dash_cooldown=0
	game.set_player_position(Vector2.ZERO);game.facing=Vector2.RIGHT;game.camera.position=Vector2.ZERO;game.camera.force_update_scroll();game.hud.update_hud()
func run():
	root.content_scale_mode=Window.CONTENT_SCALE_MODE_VIEWPORT;root.content_scale_aspect=Window.CONTENT_SCALE_ASPECT_EXPAND;root.size=Vector2i(1080,2400)
	game=load("res://scenes/main.tscn").instantiate();root.add_child(game);await settle()
	var character=Data.fresh("Mage");character.level=15;character.int=60;game.start_character(character);game.set_physics_process(false)
	var manager=game.hud.controls
	for action in ["move_left","move_right","move_up","move_down","attack","dodge","spell_1","interact","pause"]: check(InputMap.has_action(action),"InputMap declares shared action: "+action)
	for dims in [Vector2i(1080,2400),Vector2i(2400,1080)]:
		root.size=dims;game.adapt_screen();await settle();game.hud.layout()
		for mode in ["joystick","dpad"]:
			manager.model.data.options.movement=mode;manager.model.data.options.floating=false;manager.apply();fresh()
			var stick=game.hud.stick;var center=stick.get_global_rect().get_center()
			for direction in [Vector2.UP,Vector2.DOWN,Vector2.LEFT,Vector2.RIGHT,Vector2(1,1).normalized(),Vector2(-1,-1).normalized()]:
				game.set_player_position(Vector2.ZERO);var at=center+direction*stick.size.x*.4
				touch(at,0);check(game.move_vector.dot(direction)>.99,"Immediate eight-way input: "+mode+" "+str(direction)+" "+str(dims))
				check(game.input_router.movement().length()<=1.001,"Diagonal speed stays normalized: "+mode)
				game.tick(.08);check(game.player_position().dot(direction)>8,"Shared walking and collision path advances: "+mode)
				touch(at,0,false);check(game.move_vector==Vector2.ZERO,"Release stops without drift: "+mode)
			fresh();game.enemies.append(game.create_enemy(Vector2(140,0),1,"goblin"));var at=center+Vector2(stick.size.x*.4,0);touch(at,0)
			var attack=game.hud.attack_button.get_global_rect().get_center();touch(attack,1)
			check(game.attack_held and game.move_vector.x>.99,"Independent fingers hold move and attack: "+mode)
			var spell=game.hud.spell_buttons.fire.get_global_rect().get_center();var mana=game.hero.mp;touch(spell,2)
			check(game.hero.mp==mana-12 and game.move_vector.x>.99 and game.attack_held,"Third finger casts once without stealing movement: "+mode)
			var echo=InputEventMouseButton.new();echo.device=-1;echo.position=spell;echo.button_index=MOUSE_BUTTON_LEFT;echo.pressed=true;root.push_input(echo,true)
			check(game.hero.mp==mana-12,"Emulated touch mouse cannot double-cast: "+mode)
			touch(spell,2,false);game.spell_cooldowns.fire=0;game.hud.spell_buttons.fire.disabled=true
			var refreshed_mana=game.hero.mp;touch(spell,2);touch(spell,2,false)
			check(game.hero.mp==refreshed_mana-12,"An expired cooldown accepts touch before the next HUD text update: "+mode)
			var dash=game.hud.dash_button.get_global_rect().get_center();touch(dash,3)
			check(game.dash_time>0 and game.move_vector.x>.99,"Dodging retains held movement: "+mode)
			touch(dash,3,false);drag(attack+Vector2(0,-200),1)
			check(not game.attack_held and game.move_vector.x>.99,"Sliding off attack releases only that finger: "+mode)
			touch(attack,1,false);touch(at,0,false,true)
			check(stick.finger==-1 and stick.fingers.is_empty() and game.move_vector==Vector2.ZERO,"Canceled Android touch clears ownership: "+mode)
			fresh();game.begin_build("Wall");game.set_physics_process(false);await settle();touch(at,0)
			var rotate=manager.registry.build_rotate.get_global_rect().get_center();touch(rotate,4);touch(rotate,4,false)
			check(game.build_rotation==1 and game.move_vector.x>.99,"Building rotation works while walking: "+mode)
			var cancel=manager.registry.build_cancel.get_global_rect().get_center();touch(cancel,4);touch(cancel,4,false);touch(at,0,false)
			check(game.build_recipe.is_empty(),"Customizable build cancel retains existing construction: "+mode)
			fresh();touch(at,0);touch(manager.registry.inventory.get_global_rect().get_center(),5)
			check(not game.playing and game.hud.current_page=="gear" and game.move_vector==Vector2.ZERO,"Inventory opens and safely releases movement: "+mode)
			touch(manager.registry.inventory.get_global_rect().get_center(),5,false);fresh()
		fresh();manager.model.data.options.movement="joystick";manager.apply()
		var old_slot=game.hero.spells.slots[0];game.hero.spells.known.meteor=1;game.hero.spells.slots[0]="meteor";game.hud.update_hud()
		var held_attack=game.hud.attack_button.get_global_rect().get_center();touch(held_attack,1)
		var ground_spell=game.hud.spell_buttons.fire.get_global_rect().get_center();touch(ground_spell,2);touch(ground_spell,2,false)
		var target=game.get_canvas_transform()*Vector2(80,-60);touch(target,3);touch(target,3,false);await settle()
		var confirm=game.hud.spell_ui.cast_button.get_global_rect().get_center();touch(confirm,4);touch(confirm,4,false)
		game.attack_cooldown=0;game.swing_time=0;game.tick(.016)
		check(game.spellbook.targeting.is_empty() and game.swing_time>0 and game.input_router.is_virtual_held("attack"),"Held touch attack resumes after confirming a ground spell "+str(dims))
		touch(held_attack,1,false);game.hero.spells.slots[0]=old_slot;fresh()
		# D-pad tracks two directions independently and keeps the remaining finger.
		manager.model.data.options.movement="dpad";manager.apply();fresh()
		var stick=game.hud.stick;var center=stick.get_global_rect().get_center();var up=center+Vector2(0,-stick.size.y*.35);var right=center+Vector2(stick.size.x*.35,0)
		touch(up,0);touch(right,1)
		check(game.move_vector.is_equal_approx(Vector2(1,-1).normalized()),"Two D-pad fingers combine into a diagonal "+str(dims))
		touch(up,0,false);check(game.move_vector==Vector2.RIGHT,"Releasing one D-pad key keeps the other held")
		drag(center+Vector2(250,0),1);check(game.move_vector==Vector2.ZERO,"Dragging off D-pad stops movement")
		drag(right,1);check(game.move_vector==Vector2.RIGHT,"Sliding back onto a held D-pad resumes movement")
		manager.model.data.options.movement="joystick";manager.apply();check(game.move_vector==Vector2.ZERO and stick.fingers.is_empty(),"Switching styles releases the previous movement device")
		touch(right,1,false)
		manager.model.data.options.floating=true;manager.apply();fresh();var safe=manager.safe_rect();var start=safe.position+Vector2(safe.size.x*.2,safe.size.y*.48)
		touch(start,6);check(stick.finger==6 and game.move_vector==Vector2.ZERO,"Floating joystick centers on the initial movement-area touch")
		drag(start+Vector2(55,0),6);check(game.move_vector.x>.99,"Floating joystick responds immediately from its new center")
		touch(start,6,false);check(game.move_vector==Vector2.ZERO,"Floating joystick centers on release")
		for fraction in [Vector2(.03,.7),Vector2(.2,.98)]:
			var edge=safe.position+safe.size*fraction;touch(edge,6)
			check(stick.finger==6 and game.move_vector==Vector2.ZERO,"Floating edge touch stays centered without unintended movement "+str(fraction))
			drag(edge+Vector2(20,-20),6)
			check(game.move_vector.normalized().dot(Vector2(1,-1).normalized())>.99,"Floating edge movement uses the original touch anchor")
			touch(edge,6,false)
		manager.model.data.options.floating=false;manager.apply();fresh()
		key(KEY_D);await settle();touch(center+Vector2(-50,0),0)
		check(game.input_router.movement().length()<.01,"Opposing keyboard and touch directions combine consistently")
		touch(center,0,false);check(game.input_router.movement().x>.99,"Releasing touch cannot release a held keyboard action")
		key(KEY_D,false);await settle();check(game.input_router.movement()==Vector2.ZERO,"Keyboard release does not leave movement stuck")
		var joy=InputEventJoypadMotion.new();joy.device=17;joy.axis=JOY_AXIS_LEFT_X;joy.axis_value=.8;Input.parse_input_event(joy);await settle()
		check(game.input_router.movement().x>.7,"Injected gamepad axis uses the shared movement action")
		manager.release_all();check(game.input_router.movement().x>.7,"Touch reset leaves gamepad movement independent")
		joy.axis_value=0;Input.parse_input_event(joy);await settle()
		check(game.input_router.movement()==Vector2.ZERO,"Gamepad neutral releases movement")
		manager.model.reassign("dodge","attack",manager.orientation());manager.apply();fresh()
		var assigned=manager.registry.dodge.get_global_rect().get_center();touch(assigned,1)
		check(game.attack_held and game.dash_time==0,"Reassigned attack has held attack semantics")
		touch(assigned,1,false);touch(manager.registry.attack.get_global_rect().get_center(),1)
		check(game.dash_time>0 and not game.attack_held,"Swapped dodge slot calls the same gameplay function")
		touch(assigned,1,false);manager.release_all();manager.model.apply_preset("Classic RPG");manager.apply()
	# Exercise the same controls on a real loaded castle floor.
	fresh();game.set_player_position(game.landscape.KEEP);check(game.castle.enter(),"Real castle entrance transition succeeds");game.set_physics_process(false);manager.model.data.options.movement="dpad";manager.apply();game.hud.update_hud()
	var center=game.hud.stick.get_global_rect().get_center();touch(center+Vector2(45,0),0);game.tick(.05)
	check(game.hero.dungeon!=null and game.is_walking,"D-pad movement stays live inside a castle dungeon")
	game._notification(MainLoop.NOTIFICATION_APPLICATION_FOCUS_OUT)
	check(not game.playing and game.move_vector==Vector2.ZERO and not game.attack_held,"Backgrounding releases all active virtual input")
	manager.connected=true;manager.model.data.options.hide_on_gamepad=true;game.hud.resume();manager.update_visibility()
	check(not game.hud.stick.visible and not game.hud.attack_button.visible and manager.registry.pause.visible,"Gamepad hiding preserves an accessible pause menu")
	manager.connected=false;manager.update_visibility();check(game.hud.stick.visible and game.hud.attack_button.visible,"Disconnecting restores the saved touchscreen layout")
	manager.connected=true;game.hud.show_pause();await settle()
	var focused=root.gui_get_focus_owner()
	check(focused is Button and game.hud.content.is_ancestor_of(focused),"Connected gamepad menus receive a usable initial focus")
	var accept=InputEventJoypadButton.new();accept.device=17;accept.button_index=JOY_BUTTON_A;accept.pressed=true;Input.parse_input_event(accept);await settle()
	accept.pressed=false;Input.parse_input_event(accept);await settle()
	check(game.playing,"Gamepad A activates the focused Resume button without a touchscreen")
	game.hud.show_pause();await settle()
	var cancel=InputEventJoypadButton.new();cancel.device=17;cancel.button_index=JOY_BUTTON_B;cancel.pressed=true;Input.parse_input_event(cancel);await settle()
	check(game.playing,"Gamepad Back resumes from the pause menu without touchscreen input")
	cancel.pressed=false;Input.parse_input_event(cancel)
	print("%d MULTITOUCH AND INPUTMAP CHECKS PASSED" % checks);quit()
